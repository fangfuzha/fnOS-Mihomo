#!/bin/bash
#
# 更新后：补可执行位、给老配置补齐新增项，然后把服务拉起来。

set -u

CMD_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
ENV_FILE="${TRIM_PKGETC}/config.env"

chmod +x "${TRIM_APPDEST}/bin/panel" 2>/dev/null
chmod +x "${TRIM_APPDEST}/bin/mihomo" 2>/dev/null
if [ -n "$CMD_DIR" ]; then
    chmod +x "${CMD_DIR}"/* 2>/dev/null
fi

append_if_missing() {
    key="$1"
    value="$2"
    if [ -f "$ENV_FILE" ] && ! grep -q "^${key}=" "$ENV_FILE" 2>/dev/null; then
        printf "%s=%q\n" "$key" "$value" >> "$ENV_FILE"
    fi
}

append_if_missing SUB_URL ""
append_if_missing MIXED_PORT "7890"
append_if_missing CONTROLLER_PORT "9090"
append_if_missing CONTROLLER_SECRET ""
append_if_missing MODE "rule"
append_if_missing RULES_MODE "balanced"
append_if_missing ALLOW_LAN "false"

if [ -f "$ENV_FILE" ]; then
    chmod 600 "$ENV_FILE" 2>/dev/null
fi

# 应用中心通常会在升级后自动拉起，重复 start 是幂等的（内部会先判 status）
if [ -n "$CMD_DIR" ] && [ -x "${CMD_DIR}/main" ]; then
    "${CMD_DIR}/main" start
fi

exit 0
