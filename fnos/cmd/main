#!/bin/bash
#
# Mihomo 运行控制：start / stop / status
# 退出码约定：0 = 成功或正在运行；1 = 失败；3 = status 时表示未运行。
#
# 面板端口 8765 同时写死在 manifest.service_port、app/ui/config 与本脚本，
# 改端口时必须三处同步修改，否则飞牛桌面入口会指向没人监听的端口。

CMD_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
APPDEST="${TRIM_APPDEST:-$(cd "${CMD_DIR}/.." 2>/dev/null && pwd)}"

# 环境变量可能缺失（例如手工执行本脚本时）。
# 飞牛的目录布局是固定的：/var/apps/<appname>/var -> /volX/@appdata/<appname>，
# 所以这里可以按 appname 兜底推算，不必依赖调用方一定注入变量。
APP_NAME="$(basename "$APPDEST")"
if [ -z "${TRIM_PKGVAR:-}" ] && [ -d "/var/apps/${APP_NAME}/var" ]; then
    TRIM_PKGVAR="/var/apps/${APP_NAME}/var"
fi

LOG_FILE="${TRIM_PKGVAR:-/tmp}/mihomo-panel.log"
PID_FILE="${TRIM_PKGVAR:-/tmp}/mihomo-panel.pid"

PANEL_BIN="${APPDEST}/bin/panel"

log_msg() {
    echo "[fnos] $(date "+%Y-%m-%d %H:%M:%S") - $1" >> "$LOG_FILE" 2>/dev/null
}

check_process() {
    kill -0 "$1" 2>/dev/null
}

status() {
    if [ -r "$PID_FILE" ]; then
        pid="$(head -n 1 "$PID_FILE" 2>/dev/null | tr -d "[:space:]")"
        if [ -n "$pid" ] && check_process "$pid"; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

start_process() {
    if status; then
        log_msg "服务已在运行，跳过重复启动"
        return 0
    fi

    # fpk 打包会丢掉可执行位，每次启动都补一次最保险
    chmod +x "${PANEL_BIN}" 2>/dev/null
    chmod +x "${APPDEST}/bin/mihomo" 2>/dev/null

    if [ ! -x "${PANEL_BIN}" ]; then
        log_msg "面板程序不存在或不可执行: ${PANEL_BIN}"
        echo "Mihomo 面板程序缺失，请卸载后重新安装。" > "$TRIM_TEMP_LOGFILE"
        return 1
    fi

    mkdir -p "${TRIM_PKGVAR}" 2>/dev/null

    log_msg "正在启动 Mihomo 面板 ..."
    nohup "${PANEL_BIN}" --port 8765 --data "${TRIM_PKGVAR}" --bin "${APPDEST}" --web "${APPDEST}/www" --etc "${TRIM_PKGETC:-/var/apps/${APP_NAME}/etc}" >> "$LOG_FILE" 2>&1 &
    pid=$!
    printf "%s" "$pid" > "$PID_FILE"

    # 给进程一点时间暴露启动期错误
    sleep 3
    if check_process "$pid"; then
        log_msg "启动完成 pid=${pid}"
        return 0
    fi

    log_msg "启动失败，详情见 ${LOG_FILE}"
    rm -f "$PID_FILE"
    echo "Mihomo 面板启动失败，请查看日志 ${LOG_FILE}。" > "$TRIM_TEMP_LOGFILE"
    return 1
}

stop_process() {
    log_msg "正在停止 Mihomo 面板 ..."

    if [ -r "$PID_FILE" ]; then
        pid="$(head -n 1 "$PID_FILE" 2>/dev/null | tr -d "[:space:]")"
        if [ -n "$pid" ] && check_process "$pid"; then
            kill -TERM "$pid" 2>/dev/null

            n=0
            while check_process "$pid" && [ "$n" -lt 15 ]; do
                sleep 1
                n=$((n + 1))
            done

            if check_process "$pid"; then
                log_msg "进程未响应 TERM，改用 KILL"
                kill -KILL "$pid" 2>/dev/null
                sleep 1
            fi
        fi
        rm -f "$PID_FILE"
    fi

    # 兜底：pid 文件可能丢失或指向已复用的进程号，按可执行文件路径收一次尾
    pkill -f "${PANEL_BIN}" 2>/dev/null
    # 内核也一并收掉，别让 mihomo 变成孤儿进程继续占着代理端口
    pkill -f "${APPDEST}/bin/mihomo" 2>/dev/null

    log_msg "已停止"
    return 0
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    fi
    exit 3
    ;;
*)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
