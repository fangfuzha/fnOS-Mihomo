# NAS 部署工具（go run ./scripts deploy）的参数文件模板（dotenv 格式）
#
# 用法：复制一份成 .env，按自己的环境改。
#   cp .env.example .env
#
# .env 在项目根目录，含密码，不要提交到版本库。
# 优先级：进程环境变量 > 本文件。

# ---- NAS 连接 ----
# NAS 主机名：飞牛设备名，通常是 <机器名> 或 <机器名>.local。
# 用主机名而不是 IP：换网络环境、IP 变了都不用改这里。
NAS_HOST=
NAS_PORT=22
# SSH 登录用户名
NAS_USER=
# 登录密码。留空则改用 SSH 私钥（见下方 NAS_KEY_FILE）。
NAS_PASS=
# sudo 的密码。留空表示与登录密码相同。
NAS_SUDO_PASS=
# 私钥路径（可选）。给了就用私钥认证，忽略 NAS_PASS。
NAS_KEY_FILE=
# host key 校验用的 known_hosts。首次连接先用 hostkey 子命令取指纹写进去。
NAS_KNOWN_HOSTS=./known_hosts

# ---- NAS 上的安装位置 ----
APP_NAME=Mihomo
APP_DIR=/vol1/@appcenter/Mihomo
APPDATA_DIR=/vol1/@appdata/Mihomo
# 向导配置文件所在目录（飞牛在 /vol1/@appconf/<应用名>）。
ETC_DIR=/vol1/@appconf/Mihomo
PANEL_PORT=8765
# 内核控制端口（verify 用它探 /ui/）。
CONTROLLER_PORT=9090
# 远端临时目录，上传先落这儿再用 sudo 挪过去。
REMOTE_TMP=/tmp

# ---- 本地路径 ----
# 相对路径按 REPO_ROOT 解析；REPO_ROOT 默认就是 .env 所在的项目根目录。
#REPO_ROOT=.
# 要热更新的面板二进制（go run ./scripts build 打完在 build/<架构>/app/bin/panel）。
PANEL_BIN=build/amd64/app/bin/panel
# 前端源目录（web/ 是唯一源）。
WEB_DIR=web
# 要检查的安装包。
FPK_FILE=build/Mihomo-x86.fpk
